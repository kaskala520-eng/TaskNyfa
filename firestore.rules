rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Rules for users collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Rules for transactions collection
    match /transactions/{transactionId} {
      allow read, write: if true;
    }

    // Rules for platforms
    match /platforms/{platformId} {
      allow read, write: if true;
    }

    // Rules for settings
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Rules for marketplace_orders
    match /marketplace_orders/{orderId} {
      allow read, write: if true;
    }

    // Rules for quick_tasks
    match /quick_tasks/{taskId} {
      allow read, write: if true;
    }

    // Rules for accepted_services
    match /accepted_services/{serviceId} {
      allow read, write: if true;
    }
  }
}
